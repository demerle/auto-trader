# Copy to .env. Never commit .env; live keys go in secrets/live.env (phase 7).
POSTGRES_PASSWORD=change-me
AT_FINNHUB_API_KEY=
# Alpaca paper keys (phase 3)
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# Password for the least-privilege Postgres role used by the agents (created by the migration)
AGENT_DB_PASSWORD=change-me

# Dashboard login (phase 6): a long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
AT_DASHBOARD_TOKEN=
# Alerts and the daily report as Discord DMs from your bot (it must share a server with you):
AT_DISCORD_BOT_TOKEN=
AT_DISCORD_USER_ID=
# ...or to a channel: Edit Channel > Integrations > Webhooks > New Webhook > Copy URL
AT_DISCORD_WEBHOOK=
